# Server (set in fly.toml [env] or `fly secrets set` on Fly)
PORT=8787
NODE_ENV=production
# Comma-separated sites allowed to open a game socket. Default in production: same host.
ALLOWED_ORIGINS=https://hunch.example.com
MAX_ROOMS=5000
MAX_CONN_PER_IP=40
DRAIN_MAX_MS=240000

# Client (read at build time by Vite)
# off | placeholder | live
VITE_ADS=placeholder
